{
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/thoughtbot/devcontainers/features/browsers:1": {},
    "ghcr.io/thoughtbot/devcontainers/features/asdf:1": {},
    "ghcr.io/thoughtbot/devcontainers/features/asdf-plugin-ruby:1": {
      "versions": "3.0,3.1,3.2,3.3,3.4,4.0,4.0.0"
    },
    "ghcr.io/thoughtbot/devcontainers/features/asdf-plugin-nodejs:1": {
      "versions": "24.19.0,lts"
    },
  },
  "remoteUser": "codespace",
  "containerUser": "codespace",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "shopify.ruby-lsp"
      ],
    }
  }
}
